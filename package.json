{
  "name": "carte-chambery",
  "private": true,
  "version": "0.1.0",
  "description": "POC — diorama 3D interactif du centre historique de Chambéry",
  "type": "module",
  "scripts": {
    "data": "node frontend/carte/scripts/fetch-osm.mjs",
    "check:streets": "node frontend/carte/scripts/check-street-labels.mjs",
    "dev": "vite frontend/carte",
    "dev:admin": "vite frontend/admin",
    "typecheck": "tsc --noEmit -p frontend/carte && tsc --noEmit -p frontend/admin && tsc --noEmit -p . && tsc --noEmit -p tsconfig.vercel-check.json",
    "build:carte": "vite build frontend/carte",
    "build:admin": "vite build frontend/admin",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run typecheck && node scripts/check-boundaries.mjs && node scripts/check-api-esm.mjs && npm run build:carte && npm run build:admin",
    "build:pi": "tsc --noEmit -p frontend/carte && node scripts/check-boundaries.mjs && npm run build:carte",
    "preview": "vite preview frontend/carte",
    "nature": "node frontend/carte/scripts/convert-nature.mjs",
    "mascot": "node frontend/carte/scripts/convert-mascot.mjs",
    "buildings": "node frontend/carte/scripts/convert-buildings.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "test": "vitest run",
    "api:dev": "tsx backend/src/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "check:api": "node scripts/check-api-esm.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "three": "^0.186.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hono/node-server": "^2.1.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "meshoptimizer": "^1.3.0",
    "straight-skeleton": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
